{
  "name": "doc-doc",
  "productName": "DocDoc",
  "version": "1.5.0",
  "description": "A simple, friendly document editor for Windows",
  "main": "main.js",
  "author": "iamkyno",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "vendor": "node scripts/vendor.js"
  },
  "dependencies": {
    "@turbodocx/html-to-docx": "^1.23.1",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "docx-preview": "^0.4.1",
    "electron": "45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.iamkyno.docdoc",
    "productName": "DocDoc",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Word Document",
        "role": "Editor"
      },
      {
        "ext": "doc",
        "name": "Word 97-2003 Document",
        "role": "Editor"
      },
      {
        "ext": "rtf",
        "name": "Rich Text Document",
        "role": "Editor"
      },
      {
        "ext": "odt",
        "name": "OpenDocument Text",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DocDoc",
      "artifactName": "DocDoc-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iamkyno",
        "repo": "doc-doc",
        "releaseType": "release"
      }
    ]
  }
}
